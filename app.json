{
  "expo": {
    "name": "Sound First",
    "slug": "sound-first-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1410"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soundfirst.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sound First needs microphone access to hear you play and detect pitch.",
        "NSCameraUsageDescription": "Sound First may use camera for future features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1410"
      },
      "package": "com.soundfirst.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Sound First needs microphone access to hear you play and detect pitch."
        }
      ]
    ]
  }
}
